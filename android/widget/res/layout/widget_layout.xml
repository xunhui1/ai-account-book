<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面 Widget 布局 - 一键快速记账 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <!-- 标题 -->
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📝 AI记账"
        android:textSize="16sp"
        android:textColor="#333333"
        android:textStyle="bold" />

    <!-- 今日支出 -->
    <TextView
        android:id="@+id/widget_today_expense"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="今日支出: ¥0.00"
        android:textSize="13sp"
        android:textColor="#999999"
        android:layout_marginTop="4dp" />

    <!-- 按钮区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:gravity="center">

        <!-- 记支出按钮 -->
        <Button
            android:id="@+id/btn_quick_expense"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="💸 记支出"
            android:textSize="13sp"
            android:background="@drawable/btn_expense_bg"
            android:textColor="#ffffff"
            android:layout_marginEnd="4dp" />

        <!-- 记收入按钮 -->
        <Button
            android:id="@+id/btn_quick_income"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="💰 记收入"
            android:textSize="13sp"
            android:background="@drawable/btn_income_bg"
            android:textColor="#ffffff"
            android:layout_marginStart="4dp" />

    </LinearLayout>

</LinearLayout>
